{
  "name": "pi-auto-continue",
  "version": "0.1.0",
  "description": "Pi coding agent extension to automatically resume and retry sessions interrupted by rate limits, quota exhaustion, or token limits.",
  "type": "module",
  "main": "index.ts",
  "types": "src/types.ts",
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-coding-agent",
    "pi-extension",
    "auto-continue",
    "auto-resume",
    "retry",
    "rate-limit",
    "quota",
    "quota-limit",
    "quota-reset"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jellyhuck/pi-auto-continue.git"
  },
  "homepage": "https://github.com/jellyhuck/pi-auto-continue#readme",
  "bugs": {
    "url": "https://github.com/jellyhuck/pi-auto-continue/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}